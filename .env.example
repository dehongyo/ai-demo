# Bailian (Alibaba Cloud Model Studio) API Configuration
# Get your API key from: https://bailian.console.aliyun.com/
DASHSCOPE_API_KEY=your-api-key-here

# Bailian workspace base URL (Beijing region example)
# Format: https://{WorkspaceId}.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
BAILIAN_BASE_URL=your-workspace-base-url-here

# Model name (default: qwen3.6-plus)
BAILIAN_MODEL=qwen3.6-plus
